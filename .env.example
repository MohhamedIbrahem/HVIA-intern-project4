# =============================================================================
# HVIA Task 04 — Environment Configuration Template
# Copy this file to .env and fill in your values:  cp .env.example .env
# NEVER commit .env to Git — it contains secrets!
# =============================================================================

# --- PostgreSQL Database ---
POSTGRES_USER=hvia_admin
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD
POSTGRES_DB=amira_training_lab
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# --- Ollama (Local AI — Strictly Local Only) ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=30
OLLAMA_MAX_RETRIES=2

# --- Application Settings ---
LOG_LEVEL=INFO
LOG_DIR=logs

# --- Data Quality Thresholds ---
DQ_FUZZY_MATCH_THRESHOLD=88
DQ_OUTLIER_IQR_FACTOR=1.5
